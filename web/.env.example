# Public Firebase WEB application configuration; never use a service account here.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Evaluation key supplied through the deployment environment, not committed.
NEXT_PUBLIC_AG_STUDIO_LICENSE=
# Only the isolated ops.rays.to deployment redirects its root to /ops.
RAYSTO_OPS_ONLY=false
