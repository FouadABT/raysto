rules_version = '2';
// Private avatar only. Restaurant images/imports remain server-authorized.
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true;
    }
    function isValidAvatar() {
      return request.resource.size > 0 && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
    }
    match /users/{uid}/avatar {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && isValidAvatar();
    }
    match /{path=**} { allow read, write: if false; }
  }
}
