# Local development only. Copy to .env and generate your own password.
POSTGRES_USER=raysto
POSTGRES_DB=raysto_backend
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_PASSWORD
RAYSTO_DB_PORT=61810

# Set in the process environment / AWS Secrets Manager when configured:
# RAYSTO_FIREBASE_ENABLED=true
# FIREBASE_PROJECT_ID=raysto-38505
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
# FIREBASE_STORAGE_BUCKET=raysto-38505.firebasestorage.app
# RAYSTO_NOTIFICATIONS_ENABLED=true
# PAYPAL_CLIENT_ID=...
# PAYPAL_CLIENT_SECRET=...
# PAYPAL_MERCHANT_ID=...
# PAYPAL_WEBHOOK_ID=...
# PAYPAL_RETURN_URL=https://backend.your-domain/payments/return
# PAYPAL_CANCEL_URL=https://backend.your-domain/payments/cancel
