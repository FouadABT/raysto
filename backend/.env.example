# Local development only. Copy to .env and generate your own password.
POSTGRES_USER=raysto
POSTGRES_DB=raysto_backend
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_PASSWORD
RAYSTO_DB_PORT=61810

# Set in the process environment / AWS Secrets Manager when configured:
# RAYSTO_FIREBASE_ENABLED=true
# FIREBASE_PROJECT_ID=raysto-38505
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
# FIREBASE_STORAGE_BUCKET=raysto-38505.firebasestorage.app
# RAYSTO_NOTIFICATIONS_ENABLED=true
# PAYPAL_CLIENT_ID=...
# PAYPAL_CLIENT_SECRET=...
# PAYPAL_MERCHANT_ID=...
# PAYPAL_WEBHOOK_ID=...
# PAYPAL_RETURN_URL=https://backend.your-domain/payments/return
# PAYPAL_CANCEL_URL=https://backend.your-domain/payments/cancel

# Connected conversation release. Enable only after migrations and tenant setup.
# RAYSTO_ROOMS_ENABLED=true
# RAYSTO_OPERATIONS_ENABLED=true
# RAYSTO_ASSISTANT_ENABLED=true
# RAYSTO_PAYPAL_MCP_ENABLED=true
# RAYSTO_PAYPAL_ENVIRONMENT=sandbox
# RAYSTO_LIVE_PAYMENTS_APPROVED=false
# RAYSTO_SINGLE_MERCHANT_SANDBOX_ENABLED=true
# RAYSTO_SANDBOX_RESTAURANT_ID=YOUR_EXPLICIT_TEST_RESTAURANT_ID
# PAYPAL_SANDBOX_CLIENT_ID=...
# PAYPAL_SANDBOX_CLIENT_SECRET=...
# PAYPAL_SANDBOX_MERCHANT_ID=...
# PAYPAL_SANDBOX_WEBHOOK_ID=...
# PAYPAL_V2_RETURN_URL=https://api.your-domain/payments/return
# PAYPAL_V2_CANCEL_URL=https://api.your-domain/payments/cancel
# RAYSTO_AI_BUDGET_STAGE=development
# Set current provider prices conservatively, including regional/reasoning costs.
# RAYSTO_AI_INPUT_USD_PER_MILLION=...
# RAYSTO_AI_OUTPUT_USD_PER_MILLION=...
